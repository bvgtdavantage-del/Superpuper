# Required. Create a key in the ScrapeGraphAI dashboard: https://scrapegraphai.com
SGAI_API_KEY=

# Optional. Default portal for search_properties when the caller omits `portal`.
# One of: bayut | propertyfinder | dubizzle | web
SGAI_PROPERTY_DEFAULT_PORTAL=bayut

# Optional. Per-request timeout in milliseconds passed to ScrapeGraphAI fetchConfig.
SGAI_PROPERTY_TIMEOUT_MS=60000
